# The Odds API key — get a free one at https://the-odds-api.com
# Leave empty (or set to "mock") to run against the built-in MockOddsProvider,
# which serves fixture data containing real 2-way and 3-way arbs for demoing.
ODDS_API_KEY=

# Server port (optional, defaults to 8787)
PORT=8787

# ————— WhatsApp alerts (optional) —————
# Twilio credentials from https://console.twilio.com — leave empty to run in
# dev mode, where WhatsApp messages are logged to the server console instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The sender number. For the free sandbox this is Twilio's shared number,
# e.g. +14155238886 (the whatsapp: prefix is optional).
TWILIO_WHATSAPP_FROM=

# Force console logging even with Twilio credentials present.
WHATSAPP_DEV_MODE=false
